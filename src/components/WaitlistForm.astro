---
import { STATES, USES } from '../content/nigeria';

interface Props {
  /** "landing" sits beside the pitch; "page" is the standalone /waitlist page. */
  variant?: 'landing' | 'page';
}
const { variant = 'landing' } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORMS_ENDPOINT ?? '';
const Heading = variant === 'page' ? 'h1' : 'h3';
---

<div class:list={['wl', variant]} data-forms-endpoint={endpoint}>
  <form class="wl-form" novalidate data-kind="waitlist">
    <div class="wl-head">
      <Heading class="wl-title">{variant === 'page' ? 'Join the Lorapay waitlist' : 'Join the waitlist'}</Heading>
      <p class="wl-sub">
        {variant === 'page' ? 'Pay anyone, online or offline. Be first in line when we open in your state.' : 'Takes about 30 seconds.'}
      </p>
    </div>

    <div class="field">
      <label for="wl-name">Full name</label>
      <input id="wl-name" name="name" class="input" type="text" autocomplete="name" placeholder="e.g. Chiamaka Eze" maxlength="80" aria-describedby="wl-name-err" />
      <p class="error" id="wl-name-err" role="alert"></p>
    </div>

    <div class="field">
      <label for="wl-phone">Phone number</label>
      <div class="phone">
        <span class="cc" aria-hidden="true">+234</span>
        <input id="wl-phone" name="phone" class="input" type="tel" inputmode="numeric" autocomplete="tel-national" placeholder="0803 123 4567" maxlength="20" aria-describedby="wl-phone-err" />
      </div>
      <p class="error" id="wl-phone-err" role="alert"></p>
    </div>

    <div class="row">
      <div class="field">
        <label for="wl-email">Email <span class="opt">(optional)</span></label>
        <input id="wl-email" name="email" class="input" type="email" autocomplete="email" placeholder="you@example.com" maxlength="120" aria-describedby="wl-email-err" />
        <p class="error" id="wl-email-err" role="alert"></p>
      </div>
      <div class="field">
        <label for="wl-state">State</label>
        <select id="wl-state" name="state" class="select" aria-describedby="wl-state-err">
          <option value="">Choose your state</option>
          {STATES.map(s => <option value={s}>{s}</option>)}
        </select>
        <p class="error" id="wl-state-err" role="alert"></p>
      </div>
    </div>

    <fieldset class="field uses">
      <legend>What will you use Lorapay for? <span class="opt">Pick any</span></legend>
      <div class="chips">
        {USES.map(u => <button type="button" class="chip" aria-pressed="false" data-use={u}>{u}</button>)}
      </div>
    </fieldset>

    <div class="hp" aria-hidden="true">
      <label for="wl-website">Leave this empty</label>
      <input id="wl-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field">
      <label class="consent">
        <input type="checkbox" name="consent" aria-describedby="wl-consent-err" />
        <span>Text me when Lorapay launches. I agree to the <a href="/privacy">privacy policy</a>.</span>
      </label>
      <p class="error" id="wl-consent-err" role="alert"></p>
    </div>

    <p class="form-error" role="alert" hidden></p>

    <button type="submit" class="btn btn-navy submit">
      <span class="label">Join the waitlist</span>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </button>
    <noscript><p class="note">Please turn on JavaScript to join the waitlist, or email us at hello@lorapay.io.</p></noscript>
  </form>

  <div class="wl-done" role="status" hidden tabindex="-1">
    <span class="tick" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>
    </span>
    <h3 class="done-title">You're on the list.</h3>
    <p class="done-text">We'll text you as soon as Lorapay opens in your state.</p>
    <div class="invite">
      <strong>Offline payments work better with more phones nearby.</strong>
      <span>Invite the people you pay most.</span>
    </div>
    <div class="done-actions">
      <a class="btn btn-navy share" href="#" target="_blank" rel="noopener">Share on WhatsApp</a>
      <button type="button" class="btn btn-quiet again">Add someone else</button>
    </div>
  </div>
</div>

<script>
  import { setupWaitlist } from '../scripts/waitlist';
  document.querySelectorAll<HTMLElement>('.wl').forEach(setupWaitlist);
</script>

<style>
  .wl {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 36px;
    box-shadow: 0 24px 60px rgba(0, 43, 91, 0.08);
  }
  .wl.page {
    border: 0;
  }
  @media (max-width: 480px) {
    .wl {
      padding: 24px 18px;
      border-radius: 22px;
    }
  }
  .wl-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .wl-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .wl-title {
    font-size: 26px;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .page .wl-title {
    font-size: 30px;
  }
  .wl-sub {
    margin: 0;
    font-size: 15px;
    color: var(--ink-soft);
  }
  .phone {
    display: flex;
    gap: 8px;
  }
  .cc {
    flex: 0 0 auto;
    min-height: 52px;
    padding: 0 14px;
    border-radius: 12px;
    background: var(--paper);
    display: inline-flex;
    align-items: center;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 15px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .row > .field {
    flex: 1 1 200px;
  }
  .uses {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .uses legend {
    margin-bottom: 10px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .consent {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14px !important;
    font-weight: 400 !important;
    line-height: 1.5;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .consent input {
    width: 20px;
    height: 20px;
    margin: 1px 0 0;
    accent-color: var(--navy);
    flex: 0 0 auto;
  }
  .form-error {
    margin: 0;
    padding: 12px 16px;
    border-radius: 12px;
    background: #fde8e6;
    color: var(--danger);
    font-size: 15px;
  }
  .submit {
    min-height: 56px;
    width: 100%;
  }
  .submit[aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }
  .wl-done {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    outline: none;
  }
  .wl-done[hidden] {
    display: none;
  }
  .tick {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    background: var(--emerald-soft);
    color: var(--emerald);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .done-title {
    font-size: 30px;
    letter-spacing: -0.02em;
    font-weight: 800;
  }
  .done-text {
    margin: 0;
    color: var(--ink-soft);
  }
  .invite {
    width: 100%;
    padding: 18px;
    border-radius: 16px;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
  }
  .invite span {
    color: var(--ink-soft);
  }
  .done-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
