---
/** The hero's phone: a payment going through nearby phones (an illustration, not a screenshot). */
---

<div class="phone-wrap">
  <div class="device">
    <div class="screen" role="img" aria-label="The Lorapay app sending 25,000 naira through nearby phones, with no network">
      <div class="top">
        <span class="label">Confirm payment</span>
        <span class="nonet">
          <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M2 2l20 20M8.5 16.5a5 5 0 017 0M5 12.9a10 10 0 015.2-2.8M19 12.9a10 10 0 00-2-1.4M12 20h.01"></path></svg>
          No network
        </span>
      </div>
      <div class="amount-card">
        <span class="small">You're sending</span>
        <span class="amount">₦25,000</span>
        <span class="rule"></span>
        <div class="who">
          <span class="avatar" aria-hidden="true">AO</span>
          <span class="who-text"><strong>Adaeze Okafor</strong><span>0803 ••• 4417 · Lorapay</span></span>
        </div>
      </div>
      <div class="mesh-card">
        <span class="mesh-title">Sending through nearby phones</span>
        <div class="hops" aria-hidden="true">
          <i class="dot on"></i><i class="dash on"></i><i class="dot on"></i><i class="dash on"></i><i class="dot ring"></i><i class="dash"></i><i class="dot"></i>
        </div>
        <span class="mesh-note">Encrypted. Phones that pass it along can't read it.</span>
      </div>
      <div class="pay">Pay ₦25,000</div>
    </div>
  </div>
  <div class="float">
    <span class="ok" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>
    </span>
    <span class="float-text"><strong>Name checked</strong><span>before you pay</span></span>
  </div>
</div>

<style>
  .phone-wrap {
    position: relative;
    width: 320px;
    max-width: 100%;
    margin: 0 auto;
  }
  .device {
    height: 560px;
    border-radius: 44px 44px 0 0;
    background: #0a1424;
    padding: 12px 12px 0;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
  }
  .screen {
    height: 100%;
    border-radius: 34px 34px 0 0;
    background: var(--paper);
    padding: 26px 20px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--navy);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .nonet {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--amber-soft);
    color: var(--amber-ink);
    font-size: 12px;
    font-weight: 700;
  }
  .amount-card {
    background: var(--white);
    border-radius: 18px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .small {
    font-size: 13px;
    color: var(--ink-soft);
  }
  .amount {
    font-family: var(--mono);
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .rule {
    height: 1px;
    background: var(--line);
    margin: 8px 0;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 15px;
    flex: 0 0 auto;
  }
  .who-text {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.35;
  }
  .who-text strong {
    font-size: 16px;
    color: var(--navy);
  }
  .mesh-card {
    background: var(--navy);
    color: var(--white);
    border-radius: 18px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mesh-title {
    font-size: 14px;
    font-weight: 600;
  }
  .mesh-note {
    font-size: 13px;
    color: var(--on-navy);
    line-height: 1.4;
  }
  .hops {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.3);
    flex: 0 0 auto;
  }
  .dot.on {
    background: var(--amber);
  }
  .dot.ring {
    background: transparent;
    border: 2px solid var(--amber);
  }
  .dash {
    flex: 1;
    border-top: 2px dashed rgba(255, 255, 255, 0.3);
  }
  .dash.on {
    border-top-color: rgba(245, 158, 11, 0.8);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot.ring {
      animation: pulse 1.6s ease-in-out infinite;
    }
    @keyframes pulse {
      50% {
        transform: scale(1.35);
      }
    }
  }
  .pay {
    margin-top: auto;
    margin-bottom: 20px;
    height: 52px;
    border-radius: 14px;
    background: var(--navy);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }
  .float {
    position: absolute;
    left: -44px;
    top: 424px; /* in the gap between the "nearby phones" card and the Pay button */
    background: var(--white);
    color: var(--navy);
    border-radius: 16px;
    padding: 12px 16px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ok {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--emerald-soft);
    color: var(--emerald);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .float-text {
    display: flex;
    flex-direction: column;
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.3;
  }
  .float-text strong {
    font-size: 14px;
    color: var(--navy);
  }
  @media (max-width: 480px) {
    .float {
      left: -8px;
    }
  }
</style>
