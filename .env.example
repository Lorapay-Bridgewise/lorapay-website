# Copy to .env for local development, and set the same names in Vercel (Project → Settings → Environment Variables).

# The Google Apps Script web app that saves waitlist and contact messages to your Google Sheet.
# See apps-script/README.md. Without it the forms say "not set up yet".
PUBLIC_FORMS_ENDPOINT=

# The site's public address, no trailing slash.
SITE_URL=https://lorapay.io
